# ============================================================
#  DSE 練習題生成器 — 環境變數
#  複製本檔為 .env.local，然後填入 API Key 即可：
#    cp .env.example .env.local
# ============================================================

# ---------- 主要 LLM：DeepSeek（預設）----------
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---------- 後備 LLM：Claude（預設停用）----------
# 設為 true 後，DeepSeek 出錯時會自動改用 Claude。
# 也可以直接把 LLM_PROVIDER 改成 claude 讓 Claude 成為主要模型。
ENABLE_CLAUDE_FALLBACK=false
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------- RAG Embedding（可選）----------
# none   = 不用 embedding，改用關鍵字檢索（不需額外 API Key，開箱即用）
# openai = 任何 OpenAI 相容的 embedding API
#          （OpenAI / SiliconFlow / 智譜 / 阿里雲百煉 ...，中文資料建議用 bge-m3 之類的多語模型）
# 注意：DeepSeek 沒有提供 embedding API。
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
# DEBUG_PROMPT=true  # 在終端機印出完整 prompt
